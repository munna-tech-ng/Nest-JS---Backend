PORT=3001
NODE_ENV=development

DATABASE_URL=postgresql://postgres:secret@localhost:5432/enova_v2_backend

# JWT
JWT_ACCESS_TOKEN_EXPIRES_IN=24*60*1000
JWT_REFRESH_TOKEN_EXPIRES_IN=48*60*1000
JWT_SECRET="jwt-secret"



# Firebase
FIREBASE_SERVICE_ACCOUNT_PATH=./src/core/config/firebase.admin.json
FIREBASE_SERVICE_ACCOUNT_JSON=./src/core/config/firebase.admin.json

# Application key for encryption or signing
APP_KEY=secret_key_for_encryption_or_signing
# Logging level (e.g., debug, info, warn, error)
LOG_LEVEL=debug